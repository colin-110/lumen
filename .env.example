# ==========================================================================
# Lumen — environment configuration
# Copy to backend/.env (or run ./setup.ps1 / `make setup`) and fill in keys.
# ==========================================================================

# ---- App -------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false

# ---- Security ----------------------------------------------------------
# The values below are development defaults. Outside ENVIRONMENT=local:
#   * a default or short SECRET_KEY is always fatal — anyone can forge a token
#     for any account, so there is no version of "keep serving" that is safe;
#   * the rest print a startup warning, and become fatal when
#     STRICT_PRODUCTION_CHECKS=true. Turn that on once you have reviewed a
#     deployment's configuration; it is off by default so that adding a new
#     check cannot turn an upgrade into an outage.
#
# Generate a real key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-key-change-me
ALLOW_OPEN_REGISTRATION=true
FIRST_SUPERUSER_EMAIL=admin@enterprise.ai
FIRST_SUPERUSER_PASSWORD=admin12345
FIRST_ORG_NAME=Acme Corp

# Registration joins the organization matching this name (case-insensitive),
# creating it only if no such organization exists yet — so colleagues who type
# the same company name land in the same tenant and share documents.

# Bearer token required to scrape /metrics. Leave unset on a private network.
# METRICS_TOKEN=

# Promote every configuration warning above to a startup failure. Right for a
# deployment holding real data; wrong for a public demo, where open
# registration is deliberate and strict mode would refuse to start.
# STRICT_PRODUCTION_CHECKS=false

# Set to true ONLY when a trusted proxy (ALB, Caddy, nginx) sits in front and
# sets X-Forwarded-For / X-Request-ID. Believing those headers when nothing
# does lets a client forge log entries and rotate past per-IP rate limits.
TRUSTED_PROXY_HEADERS=false

# ---- LLM provider(s) -----------------------------------------------------
# Configure at least one. litellm's Router will automatically fail over
# from PRIMARY_MODEL to each entry in FALLBACK_MODELS in order.
GEMINI_API_KEY=
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# OLLAMA_API_BASE=http://localhost:11434

PRIMARY_MODEL=gemini/gemini-flash-latest
FALLBACK_MODELS=

# ---- Database ------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=enterprise_ai
# POSTGRES_SERVER / POSTGRES_PORT default to localhost:5432; docker-compose
# overrides POSTGRES_SERVER=db for the backend/worker containers.

# ---- Redis / Celery --------------------------------------------------
# Host-side default port is 6380 (see docker-compose.yml comments); inside
# docker-compose the backend/worker containers override this automatically.
# Celery uses Redis as its broker too (DB 1, separate from the cache's DB 0)
# — no RabbitMQ service to run.
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1

# ---- Qdrant ----------------------------------------------------------
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# ---- Object storage (MinIO/S3) --------------------------------------
# Host-side default port is 9005 (see docker-compose.yml comments); inside
# docker-compose the backend/worker containers override this automatically.
S3_ENDPOINT_URL=http://localhost:9005
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=enterprise-docs

# ---- Optional web search fallback (Tavily) ----------------------------
WEB_SEARCH_ENABLED=false
# TAVILY_API_KEY=tvly-...
